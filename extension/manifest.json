{
  "manifest_version": 3,
  "name": "AlgoTrack DSA Sync",
  "version": "1.1.0",
  "description": "Sync public coding profiles and log accepted LeetCode problems to AlgoTrack.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://codeforces.com/*",
    "https://*.geeksforgeeks.org/*",
    "https://www.hackerrank.com/*",
    "https://www.codechef.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AlgoTrack DSA Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://www.leetcode.com/problems/*",
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
